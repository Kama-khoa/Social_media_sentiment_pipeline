# BrightData Residential Proxy (comment downloader)
BRIGHTDATA_PROXY_HOST=your-proxy-host
BRIGHTDATA_PROXY_PORT=your-proxy-port
BRIGHTDATA_USERNAME=your-proxy-username
BRIGHTDATA_PASSWORD=your-proxy-password
