FROM apache/airflow:2.10.4-python3.12

# Switch to root to install any necessary system dependencies
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Switch back to the airflow user
USER airflow

# Copy the Airflow-specific requirements file from the host
COPY docker/requirements-airflow.txt /tmp/requirements-airflow.txt

# Install the Python dependencies.
# dbt-core and dbt-bigquery are pinned together in requirements-airflow.txt to
# avoid adapter/manifest mismatches inside Airflow tasks.
USER root
RUN python -m pip install --no-cache-dir "apache-airflow==${AIRFLOW_VERSION}" -r /tmp/requirements-airflow.txt

# Switch back to the airflow user
USER airflow
